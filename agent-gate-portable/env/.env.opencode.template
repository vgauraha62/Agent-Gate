# AgentGate Cage — OpenCode Mode Template
# Copy to .env and fill in your secrets:
#   cp env/.env.opencode.template .env
#
# Flow: OpenCode CLI → Proxy (:8080) → LiteLLM (:4000) → Zen API / Ollama
# ──────────────────────────────────────────────────────────────────────

# Upstream URL for the AI API
#   http://litellm:4000           — LiteLLM (translates Anthropic → OpenAI)
#   http://host.docker.internal:11434  — Ollama (direct, no translation needed)
AGENTGATE_PROXY_ANTHROPIC_URL=http://litellm:4000

# AgentGate policy engine URL (inside Docker network)
AGENTGATE_PROXY_AGENTGATE_URL=http://agentgate:8081

# Proxy listen address
AGENTGATE_PROXY_LISTEN=:8080

# Timeouts
AGENTGATE_PROXY_POLICY_TIMEOUT=5s
AGENTGATE_PROXY_UPSTREAM_TIMEOUT=300s

# Skip license check (development mode)
AGENTGATE_PROXY_SKIP_LICENSE=true

# JWT secret for AgentGate policy engine (generate with: openssl rand -hex 16)
AGENTGATE_JWT_SECRET=YOUR_JWT_SECRET_HERE

# LiteLLM admin key
LITELLM_MASTER_KEY=sk-litellm-master-key
