{
  "version": "1",
  "policies": [
    { "id": "block-rm", "effect": "deny", "match": { "tool": "bash", "command_pattern": "rm " } },
    { "id": "block-rmdir", "effect": "deny", "match": { "tool": "bash", "command_pattern": "rmdir" } },
    { "id": "block-unlink", "effect": "deny", "match": { "tool": "bash", "command_pattern": "unlink" } },
    { "id": "block-shred", "effect": "deny", "match": { "tool": "bash", "command_pattern": "shred" } },
    { "id": "block-find-delete", "effect": "deny", "match": { "tool": "bash", "command_pattern": "-delete" } },
    { "id": "block-truncate", "effect": "deny", "match": { "tool": "bash", "command_pattern": "truncate" } },
    { "id": "block-null-trunc", "effect": "deny", "match": { "tool": "bash", "command_pattern": "/dev/null" } },
    { "id": "block-clobber", "effect": "deny", "match": { "tool": "bash", "command_pattern": ":>" } },
    { "id": "block-mke2fs", "effect": "deny", "match": { "tool": "bash", "command_pattern": "mke2fs" } },
    { "id": "block-wipefs", "effect": "deny", "match": { "tool": "bash", "command_pattern": "wipefs" } },
    { "id": "block-fdisk", "effect": "deny", "match": { "tool": "bash", "command_pattern": "fdisk" } },
    { "id": "block-parted", "effect": "deny", "match": { "tool": "bash", "command_pattern": "parted" } },
    { "id": "block-chown-r", "effect": "deny", "match": { "tool": "bash", "command_pattern": "chown -R" } },
    { "id": "block-chmod-r", "effect": "deny", "match": { "tool": "bash", "command_pattern": "chmod -R" } },
    { "id": "block-git-clean", "effect": "deny", "match": { "tool": "bash", "command_pattern": "git clean -f" } },
    { "id": "block-rimraf", "effect": "deny", "match": { "tool": "bash", "command_pattern": "rimraf" } },
    { "id": "block-rmtree", "effect": "deny", "match": { "tool": "bash", "command_pattern": "rmtree" } },
    { "id": "block-os-remove", "effect": "deny", "match": { "tool": "bash", "command_pattern": "os.remove" } },
    { "id": "block-shutil", "effect": "deny", "match": { "tool": "bash", "command_pattern": "shutil" } },
    { "id": "block-fs-rm", "effect": "deny", "match": { "tool": "bash", "command_pattern": "fs.rm" } },
    { "id": "block-wipe", "effect": "deny", "match": { "tool": "bash", "command_pattern": "wipe " } },
    { "id": "block-root", "effect": "deny", "match": { "path_pattern": "/root/*" } },
    { "id": "block-boot", "effect": "deny", "match": { "path_pattern": "/boot/*" } },
    { "id": "block-mkfs", "effect": "deny", "match": { "tool": "bash", "command_pattern": "mkfs" } },
    { "id": "block-dd", "effect": "deny", "match": { "tool": "bash", "command_pattern": "dd " } },
    { "id": "block-forkbomb", "effect": "deny", "match": { "command_pattern": "(){" } },
    { "id": "block-etc", "effect": "deny", "match": { "path_pattern": "/etc/*" } },
    { "id": "block-env-access", "effect": "deny", "match": { "command_pattern": ".env" } },
    { "id": "block-ssh-keys", "effect": "deny", "match": { "tool": "read", "path_pattern": "~/.ssh/" } },
    { "id": "block-aws-creds", "effect": "deny", "match": { "tool": "read", "path_pattern": "~/.aws/" } },
    { "id": "block-home-read", "effect": "deny", "match": { "tool": "read", "path_pattern": "/home/" } },
    { "id": "allow-bash", "effect": "allow", "match": { "tool": "bash" } },
    { "id": "allow-read-workspace", "effect": "allow", "match": { "tool_pattern": "read_*", "path_pattern": "/workspace/*" } },
    { "id": "allow-read", "effect": "allow", "match": { "tool": "read", "path_pattern": "/workspace/*" } },
    { "id": "allow-write-workspace", "effect": "allow", "match": { "tool": "write", "path_pattern": "/workspace/*" } },
    { "id": "allow-edit-workspace", "effect": "allow", "match": { "tool": "edit", "path_pattern": "/workspace/*" } }
  ]
