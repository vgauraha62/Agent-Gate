   const std = @import("std");                                                                                                                                                                
   const testing = std.testing;                                                                                                                                                               
   const JWT = @import("jwt").JWT;                                                                                                                                                            
                                                                                                                                                                                              
   // SecurityArena from Day 2 for JWT parsing                                                                                                                                                
   const SecurityArena = @import("memory").SecurityArena;                                                                                                                                     
                                                                                                                                                                                              
   // Error union for auth failures                                                                                                                                                           
   const AuthError = error{                                                                                                                                                                   
       Unauthorized,    // Missing or invalid auth header                                                                                                                                     
       InvalidToken,    // JWT format invalid after parsing                                                                                                                                   
       ExpiredToken,    // JWT exp claim expired                                                                                                                                              
       WrongSecret,     // JWT signature doesn't match secret                                                                                                                                 
       InvalidClaims,   // JWT claims validation failed                                                                                                                                       
   };                                                                                                                                                                                         
                                                                                                                                                                                              
   pub fn authenticateFromHeader(authorization: ?[]const u8) AuthError!Agent {                                                                                                                
       // 1. Check for Authorization header                                                                                                                                                   
       if (authorization == null) {                                                                                                                                                           
           return error.Unauthorized;                                                                                                                                                         
       }                                                                                                                                                                                      
                                                                                                                                                                                              
       const auth_header = authorization.o.value;                                                                                                                                             
                                                                                                                                                                                              
       // 2. Match Bearer token format: "Bearer <token>"                                                                                                                                      
       if (auth_header.len < 7) {                                                                                                                                                             
           return error.Unauthorized;                                                                                                                                                         
       }                                                                                                                                                                                      
                                                                                                                                                                                              
       // Check for "Bearer " prefix (6 bytes)                                                                                                                                                
       const is_bearer = std.mem.eql(u8, auth_header[0..7], "Bearer ");                                                                                                                       
       if (not is_bearer) return error.Unauthorized;                                                                                                                                          
                                                                                                                                                                                              
       const token = auth_header[7..];                                                                                                                                                        
       if (token.len == 0) return error.Unauthorized;                                                                                                                                         
                                                                                                                                                                                              
       // 3. Parse JWT using SecurityArena                                                                                                                                                    
       const arena = try SecurityArena.alloc(1024);                                                                                                                                           
       defer arena.deinit();                                                                                                                                                                  
                                                                                                                                                                                              
       // Allocate arena for JWT parsing                                                                                                                                                      
       const buffer = arena.alloc(u8, 2288);                                                                                                                                                  
       const arena_arena = arena.arena;                                                                                                                                                       
       const jwt_result = JWT.parse(token, buffer, arena_arena) catch |err| {                                                                                                                 
           if (err == error.ParseInvalidToken) {                                                                                                                                              
               return error.InvalidToken;                                                                                                                                                     
           }                                                                                                                                                                                  
           return error.InvalidToken;                                                                                                                                                         
       };                                                                                                                                                                                     
                                                                                                                                                                                              
       // 4. Verify JWT with signing secret                                                                                                                                                   
       // Extract token payload and signature for verification                                                                                                                                
       const jwt_string = token;  // Original token string                                                                                                                                    
       const payload = jwt_result.payload;                                                                                                                                                    
                                                                                                                                                                                              
       // Verify using JWT.verify with the configured secret key                                                                                                                              
       const verify_result = JWT.verify(jwt_string, payload, buffer, arena_arena) catch |err| {                                                                                               
           switch (err) {                                                                                                                                                                     
               error.ExpiredToken => return error.ExpiredToken,                                                                                                                               
               error.IncorrectSignature => return error.WrongSecret,                                                                                                                          
               else => return error.InvalidClaims,                                                                                                                                            
           }                                                                                                                                                                                  
       };                                                                                                                                                                                     
                                                                                                                                                                                              
       // 5. Extract agent identity from verified claims                                                                                                                                      
       const agent = Agent{                                                                                                                                                                   
           .subject = try std.unicode.utf8_decodeScalarSlice(payload.get_sub()),                                                                                                              
       };                                                                                                                                                                                     
                                                                                                                                                                                              
       return agent;                                                                                                                                                                          
   }                                                                                                                                                                                          
                                                                                                                                                                                              
   pub fn AuthMiddleware.handle(header: []const u8, request: Request) !Agent {                                                                                                                
       // Extract Authorization header from request                                                                                                                                           
       const auth_header: []const u8 = request.get_header("Authorization") o?? "";                                                                                                            
                                                                                                                                                                                              
       // Authenticate token from header                                                                                                                                                      
       return authenticateFromHeader(auth_header);                                                                                                                                            
   }                                                                                                                                                                                          
                                                                                                                                                                                              
   // Request helper (assumed from Request struct in http.zig)                                                                                                                                
   pub const Request = struct {                                                                                                                                                               
       headers: std.StringHashMap([]const u8),                                                                                                                                                
       pub fn get_header(self: *Request, key: []const u8) ?[]const u8 {                                                                                                                       
           if (key.len > 0) {                                                                                                                                                                 
               const value = self.headers.get(key.ptr);                                                                                                                                       
               if (value) |v| return if (value) |v| v else nullptr;                                                                                                                           
           }                                                                                                                                                                                  
           return null;                                                                                                                                                                       
       }                                                                                                                                                                                      
   };                                                                                                                                                                                         
                                                                                                                                                                                              
   // Agent struct from Day 3 JWT module                                                                                                                                                      
   pub const Agent = struct {                                                                                                                                                                 
       subject: []const u8,                                                                                                                                                                   
       role: ?[]const u8 = null,                                                                                                                                                              
       issuer: ?[]const u8 = null,                                                                                                                                                            
                                                                                                                                                                                              
       pub fn deinit(self: Agent, arena: *anyopaque) void {                                                                                                                                   
           if (self.subject) |s| arena.free(s);                                                                                                                                               
           if (self.role) |r| arena.free(r);                                                                                                                                                  
           if (self.issuer) |i| arena.free(i);                                                                                                                                                
       }                                                                                                                                                                                      
   };                                                                                                                                                                                         
                                                                                                                                                                                              
   test "Unit 4: JWT Authentication Middleware Tests" {                                                                                                                                       
       const g = std.testing.allocator;                                                                                                                                                       
                                                                                                                                                                                              
       // Test 1: Missing Authorization header returns 401                                                                                                                                    
       test "happy path: missing auth header" {                                                                                                                                               
           const auth_header = null;                                                                                                                                                          
           var result = authenticateFromHeader(auth_header) catch;                                                                                                                            
           try testing.expect(result == .Unauthorized);                                                                                                                                       
       }                                                                                                                                                                                      
                                                                                                                                                                                              
       // Test 2: Missing Bearer prefix returns 401                                                                                                                                           
       test "error path: invalid bearer format" {                                                                                                                                             
           const auth_header = "Basic dG9rZW4=";                                                                                                                                              
           var result = authenticateFromHeader(auth_header) catch;                                                                                                                            
           try testing.expect(result == .Unauthorized);                                                                                                                                       
       }                                                                                                                                                                                      
                                                                                                                                                                                              
       // Test 3: Valid JWT returns Agent with subject                                                                                                                                        
       test "happy path: valid Bearer token" {                                                                                                                                                
           const auth_header = "Bearer                                                                                                                                                        
 eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssm5c";                                
           const result = try authenticateFromHeader(auth_header);                                                                                                                            
           try testing.expectStringSliceEqual("1234567890", result.subject);                                                                                                                  
       }                                                                                                                                                                                      
                                                                                                                                                                                              
       // Test 4: Expired JWT returns 401                                                                                                                                                     
       test "error path: expired JWT" {                                                                                                                                                       
           const expired_token = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0IiwibmFtZSI6IkpvaG4iLCJpYXQiOjE3OTIxOTY3NzJ9.sig";                                                     
           const result = try authenticateFromHeader(expired_token);                                                                                                                          
           try testing.expect(result == .ExpiredToken);                                                                                                                                       
       }                                                                                                                                                                                      
                                                                                                                                                                                              
       // Test 5: Tampered JWT returns 401                                                                                                                                                    
       test "error path: tampered JWT" {                                                                                                                                                      
           const tampered_token = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0IiwibmFtZSI6IkpvaG4iLCJpYXQiOjE3OTIxOTY3NzJ9.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssm5d";  //        
 Different signature                                                                                                                                                                          
           const result = try authenticateFromHeader(tampered_token);                                                                                                                         
           try testing.expect(result == .WrongSecret);                                                                                                                                        
       }                                                                                                                                                                                      
                                                                                                                                                                                              
       // Test 6: Wrong secret returns 401                                                                                                                                                    
       test "error path: wrong secret" {                                                                                                                                                      
           const secret_string = "test_secret";                                                                                                                                               
           const wrong_hash = try std.crypto.hash.sha256(arena, secret_string).hash;                                                                                                          
           const result = try authenticateFromHeader(auth_header);                                                                                                                            
           try testing.expect(result == .Unauthorized);  // Will use wrong verification                                                                                                       
       }                                                                                                                                                                                      
   }                                                                                                                                                                                          
                                                                                                                                                                                              
   // Helper function for token verification                                                                                                                                                  
   fn verifyWithSignature(                                                                                                                                                                    
       token: []const u8,                                                                                                                                                                     
       payload: JWT.DecodeResult,                                                                                                                                                             
       buffer: []u8,                                                                                                                                                                          
       arena: *anyopaque                                                                                                                                                                      
   ) !Agent {                                                                                                                                                                                 
       var agent = Agent{                                                                                                                                                                     
           .subject = null,                                                                                                                                                                   
       };                                                                                                                                                                                     
                                                                                                                                                                                              
       // Perform signature verification                                                                                                                                                      
       // Extract and validate claims like sub, role, exp, etc.                                                                                                                               
       const signature_valid = payload.check_signature(token, buffer, arena) catch false;                                                                                                     
                                                                                                                                                                                              
       if (signature_valid) {                                                                                                                                                                 
           // Extract and populate agent fields                                                                                                                                               
           agent.subject = payload.get_sub();                                                                                                                                                 
           agent.role = payload.get_role();                                                                                                                                                   
           return agent;                                                                                                                                                                      
       }                                                                                                                                                                                      
                                                                                                                                                                                              
       // Signature verification failed                                                                                                                                                       
       return error.WrongSecret;                                                                                                                                                              
   }                                                                                                                                                                                          
