//! HTTP Server - Async with sync fallback
//! Day 5: HTTP Server Foundation (Enhanced)
//!
//! Primary: Async server using epoll for high concurrency
//! Fallback: Synchronous POSIX sockets

const std = @import("std");
const c = std.c;
const auth = @import("auth_middleware.zig");
const types = @import("../policy/types.zig");
const audit = @import("../audit/logger.zig");
const AuditLog = audit.AuditLog;
const prometheus = @import("../metrics/prometheus.zig");

const EPOLLIN: u32 = 0x001;
const EPOLLOUT: u32 = 0x004;
const EPOLL_CTL_ADD: c_int = 1;
const EPOLL_CTL_MOD: c_int = 2;
const EPOLL_CTL_DEL: c_int = 3;

pub const HttpStatus = enum(u16) {
    ok = 200,
    bad_request = 400,
    unauthorized = 401,
    forbidden = 403,
    not_found = 404,
    internal_error = 500,
};

pub const CheckRequest = struct {
    path: []const u8,
    method: []const u8,
};

/// Parsed HTTP request - zero-allocation (no HashMap)
pub const ParsedRequest = struct {
    method: []const u8,
    path: []const u8,
    body: []const u8,
    auth_header: ?[]const u8 = null, // Extracted from headers if needed
};

pub const ServerMode = enum {
    async_epoll,
    sync_posix,
    hybrid, // Process pool + thread-per-request
};

pub fn statusText(status: HttpStatus) []const u8 {
    return switch (status) {
        .ok => "OK",
        .bad_request => "Bad Request",
        .unauthorized => "Unauthorized",
        .forbidden => "Forbidden",
        .not_found => "Not Found",
        .internal_error => "Internal Server Error",
    };
}

pub const RequestLine = struct {
    method: types.Method,
    path: []const u8,
    http_version: []const u8,
};

/// Work item for thread pool
const WorkItem = struct {
    client_fd: c_int,
    epoll_fd: c_int,
    done: bool = false,
};

/// Thread-safe work queue using mutex
const WorkQueue = struct {
    items: [256]WorkItem = undefined,
    head: usize = 0,
    tail: usize = 0,
    lock: std.Thread.Mutex = .{},

    fn enqueue(self: *WorkQueue, item: WorkItem) void {
        self.lock.lock();
        defer self.lock.unlock();
        self.items[self.tail % self.items.len] = item;
        self.tail += 1;
    }

    /// Dequeue an item - atomic operation (no race condition)
    fn dequeue(self: *WorkQueue) ?WorkItem {
        self.lock.lock();
        defer self.lock.unlock();
        if (self.head == self.tail) return null;
        const item = self.items[self.head % self.items.len];
        self.head += 1;
        return item;
    }
};

pub const Server = struct {
    allocator: std.mem.Allocator,
    port: u16,
    audit_logger: *audit.AuditLogger,
    policies: []const types.Policy,
    secret_key: []const u8,
    auth_middleware: ?*auth.AuthMiddleware = null,
    mode: ServerMode = .async_epoll,
    request_timeout_ms: u32 = 5000,
    epoll_fd: c_int = -1,
    listen_fd: c_int = -1,
    // Process pool (for scaling to 1000+ users)
    num_workers: usize = 8,  // 8 workers for 8-core machine
    worker_pids: [16]i32 = undefined,
    // Thread pool (legacy - not used with process pool)
    work_queue: WorkQueue = .{},
    worker_threads: [16]std.Thread = undefined,
    shutdown: bool = false,

    const Self = @This();

    pub fn init(
        allocator: std.mem.Allocator,
        port: u16,
        audit_logger: *audit.AuditLogger,
        policies: []const types.Policy,
        secret_key: []const u8,
        mode: ServerMode,
    ) Self {
        return Self{
            .allocator = allocator,
            .port = port,
            .audit_logger = audit_logger,
            .policies = policies,
            .secret_key = secret_key,
            .mode = mode,
        };
    }

    /// Init with timeout and middleware support (Day 6)
    pub fn initWithTimeout(
        allocator: std.mem.Allocator,
        port: u16,
        audit_logger: *audit.AuditLogger,
        policies: []const types.Policy,
        secret_key: []const u8,
        auth_middleware: *auth.AuthMiddleware,
        mode: ServerMode,
        request_timeout_ms: u32,
    ) Self {
        return Self{
            .allocator = allocator,
            .port = port,
            .audit_logger = audit_logger,
            .policies = policies,
            .secret_key = secret_key,
            .auth_middleware = auth_middleware,
            .mode = mode,
            .request_timeout_ms = request_timeout_ms,
        };
    }

    pub fn deinit(self: *Self) void {
        // Signal shutdown to workers
        self.shutdown = true;
        // Note: threads will exit on next iteration due to shutdown flag
        
        if (self.epoll_fd >= 0) {
            _ = c.close(self.epoll_fd);
        }
        if (self.listen_fd >= 0) {
            _ = c.close(self.listen_fd);
        }
    }

    /// Initialize thread pool workers
    fn initThreadPool(self: *Self) !void {
        for (0..self.num_workers) |i| {
            self.worker_threads[i] = try std.Thread.spawn(.{}, workerThread, .{
                self
            });
        }
        std.debug.print("[Thread Pool] Started {d} worker threads\n", .{self.num_workers});
    }

    /// Worker thread function - processes requests from work queue
    fn workerThread(self: *Self) void {
        while (!self.shutdown) {
            // Just try to dequeue - handles race condition automatically
            if (self.work_queue.dequeue()) |item| {
                self.processClient(item.client_fd, item.epoll_fd);
            } else {
                // No work available - brief sleep to avoid busy waiting
                std.Thread.sleep(100 * std.time.ns_per_us);
            }
        }
    }

    /// Process a client request (called from worker thread)
    fn processClient(self: *Self, client_fd: c_int, epoll_fd: c_int) void {
        defer {
            _ = c.epoll_ctl(epoll_fd, EPOLL_CTL_DEL, client_fd, null);
            _ = c.close(client_fd);
        }

        var buf: [8192]u8 = undefined;
        const bytes_read = c.read(client_fd, &buf, buf.len);

        if (bytes_read <= 0) return;

        prometheus.global_metrics.incRequests();

        const request_str = buf[0..@as(usize, @intCast(bytes_read))];
        
        // Parse request
        const parsed = parseHttpRequestMinimal(request_str) catch {
            sendErrorResponseDirect(client_fd, .bad_request, "invalid request");
            return;
        };

        // Route based on path (simplified for thread pool)
        if (std.mem.eql(u8, parsed.path, "/health") and std.mem.eql(u8, parsed.method, "GET")) {
            sendHealthResponseDirect(client_fd);
        } else if (std.mem.eql(u8, parsed.path, "/metrics") and std.mem.eql(u8, parsed.method, "GET")) {
            sendMetricsResponseDirect(client_fd);
        } else if (std.mem.eql(u8, parsed.path, "/v1/agents") and std.mem.eql(u8, parsed.method, "GET")) {
            sendAgentsListResponseDirect(client_fd);
        } else if (std.mem.eql(u8, parsed.path, "/check") and std.mem.eql(u8, parsed.method, "POST")) {
            self.sendCheckResponse(client_fd, parsed.body, request_str);
        } else {
            sendNotFoundResponseDirect(client_fd);
        }
    }

    pub fn run(self: *Self) !void {
        // Use hybrid (process pool + threads) for high concurrency
        if (self.num_workers > 1 and self.mode == .hybrid) {
            try self.runWithHybrid();
            return;
        }
        
        // Use process pool for async_epoll with multiple workers
        if (self.num_workers > 1 and self.mode == .async_epoll) {
            try self.runWithProcessPool();
            return;
        }
        
        // Single worker mode (original behavior)
        std.debug.print("[HTTP Server] Starting on port {d} in {s} mode\n", .{
            self.port,
            switch (self.mode) {
                .async_epoll => "async (epoll)",
                .sync_posix => "sync (POSIX sockets)",
                .hybrid => "hybrid (process pool + threads)",
            },
        });

        switch (self.mode) {
            .async_epoll => try self.runAsyncEpoll(),
            .sync_posix => try self.runSyncPosix(),
            .hybrid => try self.runAsyncEpoll(),
        }
    }

    /// Run with process pool - forks worker processes for horizontal scaling
    fn runWithProcessPool(self: *Self) !void {
        std.debug.print("[Process Pool] Starting {d} worker processes on port {d}\n", .{
            self.num_workers, self.port
        });

        // Create socket with SO_REUSEPORT for kernel load balancing
        self.listen_fd = c.socket(std.posix.AF.INET, std.posix.SOCK.STREAM, 0);
        if (self.listen_fd < 0) return error.SocketCreateFailed;

        const reuse_addr: c_int = 1;
        _ = c.setsockopt(self.listen_fd, std.posix.SOL.SOCKET, std.posix.SO.REUSEADDR, &reuse_addr, @sizeOf(c_int));

        // SO_REUSEPORT allows multiple processes to bind to same port
        // Kernel will distribute connections across workers
        const reuse_port: c_int = 1;
        _ = c.setsockopt(self.listen_fd, std.posix.SOL.SOCKET, std.posix.SO.REUSEPORT, &reuse_port, @sizeOf(c_int));

        var addr = std.posix.sockaddr.in{
            .family = std.posix.AF.INET,
            .port = @byteSwap(self.port),
            .addr = 0,
            .zero = [_]u8{0} ** 8,
        };

        if (c.bind(self.listen_fd, @ptrCast(&addr), @sizeOf(@TypeOf(addr))) < 0) {
            return error.BindFailed;
        }
        if (c.listen(self.listen_fd, 1024) < 0) return error.ListenFailed;

        std.debug.print("[Process Pool] Socket bound with SO_REUSEPORT\n", .{});

        // Fork worker processes
        for (0..self.num_workers) |i| {
            const pid = c.fork();
            
            if (pid < 0) {
                return error.ForkFailed;
            } else if (pid == 0) {
                // Child process - run worker event loop
                std.debug.print("[Worker {d}] Starting event loop (PID: {d})\n", .{ i, c.getpid() });
                self.runAsyncEpoll() catch {};
                // Worker never returns
                std.debug.print("[Worker {d}] Exiting\n", .{i});
                c._exit(0);
            } else {
                // Parent process - store PID
                self.worker_pids[i] = pid;
                std.debug.print("[Master] Spawned worker {d} with PID {d}\n", .{ i, pid });
            }
        }

        std.debug.print("[Master] All {d} workers spawned, waiting for signals...\n", .{self.num_workers});

        // Master process waits for children
        // In production, this would handle signals and graceful shutdown
        // For now, just block forever (server runs until killed)
        while (true) {
            const result = std.posix.waitpid(-1, 0);
            if (result.pid < 0) break;  // No more children
            std.debug.print("[Master] Worker {d} exited, restarting...\n", .{result.pid});
            // In production: restart worker here
        }
    }

    /// Run with hybrid mode - process pool + thread-per-request
    fn runWithHybrid(self: *Self) !void {
        std.debug.print("[Hybrid] Starting {d} worker processes with threads on port {d}\n", .{
            self.num_workers, self.port
        });

        // Create socket with SO_REUSEPORT for kernel load balancing
        self.listen_fd = c.socket(std.posix.AF.INET, std.posix.SOCK.STREAM, 0);
        if (self.listen_fd < 0) return error.SocketCreateFailed;

        const reuse_addr: c_int = 1;
        _ = c.setsockopt(self.listen_fd, std.posix.SOL.SOCKET, std.posix.SO.REUSEADDR, &reuse_addr, @sizeOf(c_int));
        _ = c.setsockopt(self.listen_fd, std.posix.SOL.SOCKET, std.posix.SO.REUSEPORT, &reuse_addr, @sizeOf(c_int));

        var addr = std.posix.sockaddr.in{
            .family = std.posix.AF.INET,
            .port = @byteSwap(self.port),
            .addr = 0,
            .zero = [_]u8{0} ** 8,
        };

        if (c.bind(self.listen_fd, @ptrCast(&addr), @sizeOf(@TypeOf(addr))) < 0) return error.BindFailed;
        if (c.listen(self.listen_fd, 1024) < 0) return error.ListenFailed;
        std.debug.print("[Hybrid] Master listening on port {d}\n", .{self.port});

        // Fork worker processes
        for (0..self.num_workers) |i| {
            const pid = c.fork();
            if (pid < 0) return error.ForkFailed;
            if (pid == 0) {
                // Child process - run worker with thread pool
                std.debug.print("[Worker {d}] Starting hybrid mode with thread pool (PID: {d})\n", .{ i, c.getpid() });
                self.runWithThreadPool() catch {};
                // Worker never returns
                std.debug.print("[Worker {d}] Exiting\n", .{i});
                c._exit(0);
            } else {
                // Parent process - store PID
                self.worker_pids[i] = pid;
                std.debug.print("[Master] Spawned hybrid worker {d} with PID {d}\n", .{ i, pid });
            }
        }

        std.debug.print("[Master] All {d} hybrid workers spawned, waiting for signals...\n", .{self.num_workers});

        // Master process waits for children
        while (true) {
            const result = std.posix.waitpid(-1, 0);
            if (result.pid < 0) break;
            std.debug.print("[Master] Hybrid worker {d} exited, restarting...\n", .{result.pid});
        }
    }

    /// Run worker with thread pool - each worker spawns threads for requests
    fn runWithThreadPool(self: *Self) !void {
        std.debug.print("[Worker] Starting thread pool worker\n", .{});

        // Set up epoll for listening on listen_fd
        self.epoll_fd = c.epoll_create1(0);
        if (self.epoll_fd < 0) return error.EpollCreateFailed;

        var listen_event = std.c.epoll_event{
            .events = EPOLLIN,
            .data = .{ .fd = self.listen_fd },
        };
        _ = c.epoll_ctl(self.epoll_fd, EPOLL_CTL_ADD, self.listen_fd, &listen_event);

        // Initialize thread pool
        try self.initThreadPool();
        self.shutdown = false;

        // Accept connections and dispatch to thread pool
        while (!self.shutdown) {
            var client_addr: std.posix.sockaddr.in = undefined;
            var addr_len: c.socklen_t = @sizeOf(@TypeOf(client_addr));
            
            // Non-blocking accept with timeout
            var fds: [1]std.c.epoll_event = undefined;
            const ret = c.epoll_wait(self.epoll_fd, &fds, 1, 100);
            if (ret <= 0) continue;

            const client_fd = c.accept(self.listen_fd, @ptrCast(&client_addr), &addr_len);
            if (client_fd < 0) continue;

            // Enqueue work for thread pool
            const item = WorkItem{
                .client_fd = client_fd,
                .epoll_fd = self.epoll_fd,
                .done = false,
            };
            self.work_queue.enqueue(item);
        }
    }

    fn runAsyncEpoll(self: *Self) !void {
        // Check if socket is already set (inherited from parent after fork)
        if (self.listen_fd < 0) {
            // Create new socket (master process)
            self.listen_fd = c.socket(std.posix.AF.INET, std.posix.SOCK.STREAM, 0);
            if (self.listen_fd < 0) return error.SocketCreateFailed;

            const reuse: c_int = 1;
            _ = c.setsockopt(self.listen_fd, std.posix.SOL.SOCKET, std.posix.SO.REUSEADDR, &reuse, @sizeOf(c_int));

            var addr = std.posix.sockaddr.in{
                .family = std.posix.AF.INET,
                .port = @byteSwap(self.port),
                .addr = 0,
                .zero = [_]u8{0} ** 8,
            };

            if (c.bind(self.listen_fd, @ptrCast(&addr), @sizeOf(@TypeOf(addr))) < 0) return error.BindFailed;
            if (c.listen(self.listen_fd, 1024) < 0) return error.ListenFailed;
        }

        // Set up epoll (each process needs its own epoll instance)
        self.epoll_fd = c.epoll_create1(0);
        if (self.epoll_fd < 0) return error.EpollCreateFailed;

        var event = std.c.epoll_event{
            .events = EPOLLIN,
            .data = .{ .fd = self.listen_fd },
        };
        _ = c.epoll_ctl(self.epoll_fd, EPOLL_CTL_ADD, self.listen_fd, &event);

        std.debug.print("[HTTP Server] Async server (epoll) listening on port {d}\n", .{self.port});

        var events: [64]std.c.epoll_event = undefined;

        while (true) {
            const num_events = c.epoll_wait(self.epoll_fd, &events, events.len, 1000);
            if (num_events < 0) continue;

            var i: usize = 0;
            while (i < @as(usize, @intCast(num_events))) : (i += 1) {
                const fd = events[i].data.fd;

                if (fd == self.listen_fd) {
                    var client_addr: std.posix.sockaddr.in = undefined;
                    var addr_len: c.socklen_t = @sizeOf(@TypeOf(client_addr));
                    const client_fd = c.accept(self.listen_fd, @ptrCast(&client_addr), &addr_len);

                    if (client_fd >= 0) {
                        var client_event = std.c.epoll_event{
                            .events = EPOLLIN,
                            .data = .{ .fd = client_fd },
                        };
                        _ = c.epoll_ctl(self.epoll_fd, EPOLL_CTL_ADD, client_fd, &client_event);
                    }
} else {
                    self.handleEpollClient(fd) catch {};
                }
            }
        }
    }

    fn handleEpollClient(self: *Self, client_fd: c_int) !void {
        defer {
            _ = c.epoll_ctl(@as(c_int, @intCast(self.getEpollFd())), EPOLL_CTL_DEL, client_fd, null);
            _ = c.close(client_fd);
        }

        var buf: [8192]u8 = undefined;
        const bytes_read = c.read(client_fd, &buf, buf.len);

        if (bytes_read <= 0) return;

        prometheus.global_metrics.incRequests();

        const request_str = buf[0..@as(usize, @intCast(bytes_read))];
        const parsed = self.parseHttpRequest(request_str) catch {
            self.sendErrorResponse(client_fd, .bad_request, "invalid request");
            return;
        };

        // Debug: std.debug.print("[HTTP Server] {s} {s}\n", .{ parsed.method, parsed.path });

        if (std.mem.eql(u8, parsed.path, "/health") and std.mem.eql(u8, parsed.method, "GET")) {
            self.sendHealthResponse(client_fd);
        } else if (std.mem.eql(u8, parsed.path, "/metrics") and std.mem.eql(u8, parsed.method, "GET")) {
            self.sendMetricsResponse(client_fd);
        } else if (std.mem.eql(u8, parsed.path, "/v1/agents") and std.mem.eql(u8, parsed.method, "GET")) {
            self.sendAgentsListResponse(client_fd);
        } else if (std.mem.eql(u8, parsed.path, "/check") and std.mem.eql(u8, parsed.method, "POST")) {
            self.sendCheckResponse(client_fd, parsed.body, request_str);
        } else {
            self.sendNotFoundResponse(client_fd);
        }
    }

    /// Threaded client handler - runs in separate thread for concurrent processing
    fn handleClientThreaded(
        _: std.mem.Allocator,
        _: *audit.AuditLogger,
        _: []const types.Policy,
        _: []const u8,
        client_fd: c_int,
        epoll_fd: c_int,
    ) void {
        defer {
            _ = c.epoll_ctl(epoll_fd, EPOLL_CTL_DEL, client_fd, null);
            _ = c.close(client_fd);
        }

        var buf: [8192]u8 = undefined;
        const bytes_read = c.read(client_fd, &buf, buf.len);

        if (bytes_read <= 0) return;

        prometheus.global_metrics.incRequests();

        const request_str = buf[0..@as(usize, @intCast(bytes_read))];
        
        // Parse request - use minimal server context for parsing
        const parsed = parseHttpRequestMinimal(request_str) catch {
            sendErrorResponseDirect(client_fd, .bad_request, "invalid request");
            return;
        };

        // Route based on path (simplified - no auth middleware in threads for now)
        if (std.mem.eql(u8, parsed.path, "/health") and std.mem.eql(u8, parsed.method, "GET")) {
            sendHealthResponseDirect(client_fd);
        } else if (std.mem.eql(u8, parsed.path, "/metrics") and std.mem.eql(u8, parsed.method, "GET")) {
            sendMetricsResponseDirect(client_fd);
        } else if (std.mem.eql(u8, parsed.path, "/v1/agents") and std.mem.eql(u8, parsed.method, "GET")) {
            sendAgentsListResponseDirect(client_fd);
        } else {
            sendNotFoundResponseDirect(client_fd);
        }
    }

    /// Minimal request parser for threaded handler (standalone, no self reference)
    fn parseHttpRequestMinimal(buf: []const u8) !ParsedRequest {
        var line_end: usize = 0;
        while (line_end < buf.len and buf[line_end] != '\r' and buf[line_end] != '\n') {
            line_end += 1;
        }
        if (line_end == 0) return error.InvalidRequest;

        var method_end: usize = 0;
        while (method_end < line_end and buf[method_end] != ' ') method_end += 1;
        
        var path_start = method_end;
        while (path_start < line_end and buf[path_start] == ' ') path_start += 1;
        var path_end = path_start;
        while (path_end < line_end and buf[path_end] != ' ') path_end += 1;

        if (method_end == 0 or path_start >= line_end) return error.InvalidRequest;

        const method = buf[0..method_end];
        const path = buf[path_start..path_end];

        // Find body (skip to blank line)
        var pos = line_end;
        if (pos < buf.len and buf[pos] == '\r') pos += 1;
        if (pos < buf.len and buf[pos] == '\n') pos += 1;
        
        // Skip headers until blank line
        while (pos + 1 < buf.len) {
            if (buf[pos] == '\r' and buf[pos+1] == '\n') {
                var next = pos + 2;
                while (next < buf.len and (buf[next] == '\r' or buf[next] == '\n')) next += 1;
                if (next > pos + 2) {
                    pos = next;
                    break;
                }
            }
            while (pos < buf.len and buf[pos] != '\r' and buf[pos] != '\n') pos += 1;
            if (pos < buf.len and buf[pos] == '\r') pos += 1;
            if (pos < buf.len and buf[pos] == '\n') pos += 1;
        }

        const body = if (pos < buf.len) buf[pos..] else "";

        return ParsedRequest{
            .method = method,
            .path = path,
            .body = body,
            .auth_header = null,
        };
    }

    /// Direct response functions (no self reference needed)
    fn sendErrorResponseDirect(client_fd: c_int, status: HttpStatus, message: []const u8) void {
        var body_buf: [256]u8 = undefined;
        const body = std.fmt.bufPrint(&body_buf, "{{\"error\":\"{s}\"}}\n", .{message}) catch return;
        var header_buf: [256]u8 = undefined;
        const status_text = switch (status) {
            .ok => "OK", .bad_request => "Bad Request", .unauthorized => "Unauthorized",
            .forbidden => "Forbidden", .not_found => "Not Found", .internal_error => "Internal Server Error",
        };
        const header = std.fmt.bufPrint(&header_buf,
            "HTTP/1.1 {d} {s}\r\nContent-Type: application/json\r\nContent-Length: {d}\r\n\r\n",
            .{ @intFromEnum(status), status_text, body.len },
        ) catch return;
        _ = c.write(client_fd, header.ptr, header.len);
        _ = c.write(client_fd, body.ptr, body.len);
    }

    fn sendHealthResponseDirect(client_fd: c_int) void {
        const body = "{\"status\":\"ok\",\"mode\":\"async-epoll\"}\n";
        var header_buf: [128]u8 = undefined;
        const header = std.fmt.bufPrint(&header_buf,
            "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {d}\r\n\r\n",
            .{body.len},
        ) catch return;
        _ = c.write(client_fd, header.ptr, header.len);
        _ = c.write(client_fd, body.ptr, body.len);
    }

    fn sendMetricsResponseDirect(client_fd: c_int) void {
        const export_buf = prometheus.global_metrics.exportMetrics();
        const body_len = export_buf.len + 1;
        var header_buf: [256]u8 = undefined;
        const header = std.fmt.bufPrint(&header_buf,
            "HTTP/1.1 200 OK\r\nContent-Type: text/plain; version=0.0.4\r\nContent-Length: {d}\r\n\r\n",
            .{body_len},
        ) catch return;
        _ = c.write(client_fd, header.ptr, header.len);
        _ = c.write(client_fd, export_buf.ptr, export_buf.len);
        _ = c.write(client_fd, "\n", 1);
    }

    fn sendAgentsListResponseDirect(client_fd: c_int) void {
        const body = "{\"agents\":[],\"count\":0}\n";
        var header_buf: [128]u8 = undefined;
        const header = std.fmt.bufPrint(&header_buf,
            "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {d}\r\n\r\n",
            .{body.len},
        ) catch return;
        _ = c.write(client_fd, header.ptr, header.len);
        _ = c.write(client_fd, body.ptr, body.len);
    }

    fn sendNotFoundResponseDirect(client_fd: c_int) void {
        const body = "{\"error\":\"not found\",\"mode\":\"async-epoll\"}\n";
        var header_buf: [128]u8 = undefined;
        const header = std.fmt.bufPrint(&header_buf,
            "HTTP/1.1 404 Not Found\r\nContent-Type: application/json\r\nContent-Length: {d}\r\n\r\n",
            .{body.len},
        ) catch return;
        _ = c.write(client_fd, header.ptr, header.len);
        _ = c.write(client_fd, body.ptr, body.len);
    }

    fn getEpollFd(self: *Self) c_int {
        return self.epoll_fd;
    }

    fn runSyncPosix(self: *Self) !void {
        const listen_fd = c.socket(std.posix.AF.INET, std.posix.SOCK.STREAM, 0);
        if (listen_fd < 0) return error.SocketCreateFailed;
        defer _ = c.close(listen_fd);

        const reuse: c_int = 1;
        _ = c.setsockopt(listen_fd, std.posix.SOL.SOCKET, std.posix.SO.REUSEADDR, &reuse, @sizeOf(c_int));

        var addr = std.posix.sockaddr.in{
            .family = std.posix.AF.INET,
            .port = @byteSwap(self.port),
            .addr = 0,
            .zero = [_]u8{0} ** 8,
        };

        if (c.bind(listen_fd, @ptrCast(&addr), @sizeOf(@TypeOf(addr))) < 0) return error.BindFailed;
        if (c.listen(listen_fd, 1024) < 0) return error.ListenFailed;

        std.debug.print("[HTTP Server] Sync server listening on port {d}\n", .{self.port});

        while (true) {
            var client_addr: std.posix.sockaddr.in = undefined;
            var addr_len: c.socklen_t = @sizeOf(@TypeOf(client_addr));
            const client_fd = c.accept(listen_fd, @ptrCast(&client_addr), &addr_len);

            if (client_fd < 0) continue;

            self.handleConnection(client_fd);
        }
    }

    fn handleConnection(self: *Self, client_fd: c_int) void {
        defer _ = c.close(client_fd);

        var buf: [8192]u8 = undefined;
        const bytes_read = c.read(client_fd, &buf, buf.len);

        if (bytes_read <= 0) return;

        prometheus.global_metrics.incRequests();

        const request_str = buf[0..@as(usize, @intCast(bytes_read))];
        const parsed = self.parseHttpRequest(request_str) catch {
            self.sendErrorResponse(client_fd, .bad_request, "invalid request");
            return;
        };

        // Debug: std.debug.print("[HTTP Server] {s} {s}\n", .{ parsed.method, parsed.path });

        if (std.mem.eql(u8, parsed.path, "/health") and std.mem.eql(u8, parsed.method, "GET")) {
            self.sendHealthResponse(client_fd);
        } else if (std.mem.eql(u8, parsed.path, "/metrics") and std.mem.eql(u8, parsed.method, "GET")) {
            self.sendMetricsResponse(client_fd);
        } else if (std.mem.eql(u8, parsed.path, "/v1/agents") and std.mem.eql(u8, parsed.method, "GET")) {
            self.sendAgentsListResponse(client_fd);
        } else if (std.mem.eql(u8, parsed.path, "/check") and std.mem.eql(u8, parsed.method, "POST")) {
            self.sendCheckResponse(client_fd, parsed.body, request_str);
        } else {
            self.sendNotFoundResponse(client_fd);
        }
    }

    /// Parse HTTP request - ZERO ALLOCATION (no HashMap)
    fn parseHttpRequest(_: *Self, buf: []const u8) !ParsedRequest {
        // Find request line end (first CRLF)
        var line_end: usize = 0;
        while (line_end < buf.len and buf[line_end] != '\r' and buf[line_end] != '\n') {
            line_end += 1;
        }

        if (line_end == 0) return error.InvalidRequest;

        // Parse request line: "METHOD PATH HTTP/1.1"
        // Find first space (end of method)
        var method_end: usize = 0;
        while (method_end < line_end and buf[method_end] != ' ') method_end += 1;
        
        // Skip spaces between method and path
        var path_start = method_end;
        while (path_start < line_end and buf[path_start] == ' ') path_start += 1;
        
        // Find end of path (next space)
        var path_end = path_start;
        while (path_end < line_end and buf[path_end] != ' ') path_end += 1;

        if (method_end == 0 or path_start >= line_end) return error.InvalidRequest;

        const method = buf[0..method_end];
        const path = buf[path_start..path_end];

        // Find body (skip headers, look for blank line)
        var pos: usize = line_end;
        // Skip CRLF
        if (pos < buf.len and buf[pos] == '\r') pos += 1;
        if (pos < buf.len and buf[pos] == '\n') pos += 1;

        // Skip all header lines (until we find empty line)
        while (pos < buf.len) {
            if (pos + 1 < buf.len and buf[pos] == '\r' and buf[pos + 1] == '\n') {
                // Check if next line is also CRLF (blank line before body)
                var next = pos + 2;
                while (next < buf.len and (buf[next] == '\r' or buf[next] == '\n')) {
                    next += 1;
                }
                if (next > pos + 2) {
                    pos = next;
                    break;
                }
            }
            // Skip to end of this header line
            while (pos < buf.len and buf[pos] != '\r' and buf[pos] != '\n') {
                pos += 1;
            }
            // Skip CRLF
            if (pos < buf.len and buf[pos] == '\r') pos += 1;
            if (pos < buf.len and buf[pos] == '\n') pos += 1;
        }

        const body = if (pos < buf.len) buf[pos..] else "";

        return ParsedRequest{
            .method = method,
            .path = path,
            .body = body,
            .auth_header = null,
        };
    }

    /// Zero-allocation JSON parsing for /check endpoint
    fn parseCheckRequest(_: *Self, body: []const u8) CheckRequest {
        var result = CheckRequest{ .path = "/", .method = "GET" };
        if (body.len == 0) return result;

        // Quick scan for "path" and "method" fields - no allocations
        var i: usize = 0;
        while (i + 6 < body.len) {
            // Look for "path" (5 chars)
            if (i + 5 < body.len and
                body[i] == 'p' and body[i+1] == 'a' and body[i+2] == 't' and
                body[i+3] == 'h' and body[i+4] == '"') {

                // Find colon after "path"
                var j = i + 5;
                while (j < body.len and body[j] != ':') j += 1;
                if (j >= body.len) break;

                // Skip whitespace and quotes
                j += 1;
                while (j < body.len and (body[j] == ' ' or body[j] == '\t' or body[j] == '"')) j += 1;

                // Extract value
                const start = j;
                while (j < body.len and body[j] != '"') j += 1;

                if (j > start) {
                    result.path = body[start..j];
                }
            }

            // Look for "method" (7 chars)
            if (i + 7 < body.len and
                body[i] == 'm' and body[i+1] == 'e' and body[i+2] == 't' and
                body[i+3] == 'h' and body[i+4] == 'o' and body[i+5] == 'd' and body[i+6] == '"') {

                // Find colon after "method"
                var j = i + 7;
                while (j < body.len and body[j] != ':') j += 1;
                if (j >= body.len) break;

                // Skip whitespace and quotes
                j += 1;
                while (j < body.len and (body[j] == ' ' or body[j] == '\t' or body[j] == '"')) j += 1;

                // Extract value
                const start = j;
                while (j < body.len and body[j] != '"') j += 1;

                if (j > start) {
                    result.method = body[start..j];
                }
            }

            i += 1;
        }

        return result;
    }

    fn sendHealthResponse(self: *Self, client_fd: c_int) void {
        const body_mode = if (self.mode == .async_epoll) "async-epoll" else "sync-posix";
        var body_buf: [64]u8 = undefined;
        const body = std.fmt.bufPrint(&body_buf, "{{\"status\":\"ok\",\"mode\":\"{s}\"}}\n", .{body_mode}) catch return;

        var header_buf: [128]u8 = undefined;
        const header = std.fmt.bufPrint(&header_buf,
            "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {d}\r\n\r\n",
            .{body.len},
        ) catch return;

        _ = c.write(client_fd, header.ptr, header.len);
        _ = c.write(client_fd, body.ptr, body.len);
    }

    fn sendMetricsResponse(_: *Self, client_fd: c_int) void {
        const export_buf = prometheus.global_metrics.exportMetrics();
        const body_len = export_buf.len + 1;

        var header_buf: [256]u8 = undefined;
        const header = std.fmt.bufPrint(&header_buf,
            "HTTP/1.1 200 OK\r\nContent-Type: text/plain; version=0.0.4\r\nContent-Length: {d}\r\n\r\n",
            .{body_len},
        ) catch return;

        _ = c.write(client_fd, header.ptr, header.len);
        _ = c.write(client_fd, export_buf.ptr, export_buf.len);
        _ = c.write(client_fd, "\n", 1);
    }

    /// Handle GET /v1/agents - List all registered agents
    fn sendAgentsListResponse(_: *Self, client_fd: c_int) void {
        const body = "{\"agents\":[],\"count\":0}\n";

        var header_buf: [128]u8 = undefined;
        const header = std.fmt.bufPrint(&header_buf,
            "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {d}\r\n\r\n",
            .{body.len},
        ) catch return;

        _ = c.write(client_fd, header.ptr, header.len);
        _ = c.write(client_fd, body.ptr, body.len);
    }

    /// Extract Authorization header from raw HTTP request buffer - zero allocation
    fn extractAuthHeader(buf: []const u8) ?[]const u8 {
        // Look for "Authorization:" or "authorization:" header
        var i: usize = 0;
        while (i + 14 < buf.len) { // "Authorization:" = 13 chars
            // Check for lowercase "authorization:"
            if (buf[i] == 'a' and i + 13 < buf.len and
                buf[i+1] == 'u' and buf[i+2] == 't' and buf[i+3] == 'h' and
                buf[i+4] == 'o' and buf[i+5] == 'r' and buf[i+6] == 'i' and
                buf[i+7] == 'z' and buf[i+8] == 'a' and buf[i+9] == 't' and
                buf[i+10] == 'i' and buf[i+11] == 'o' and buf[i+12] == 'n' and
                buf[i+13] == ':') {

                // Found - skip past colon and whitespace
                var j = i + 14;
                while (j < buf.len and (buf[j] == ' ' or buf[j] == '\t')) j += 1;

                // Find end of value (CRLF)
                var end = j;
                while (end < buf.len and buf[end] != '\r' and buf[end] != '\n') end += 1;

                if (end > j) {
                    return buf[j..end];
                }
            }
            // Check for uppercase "Authorization:"
            if (buf[i] == 'A' and i + 13 < buf.len and
                buf[i+1] == 'U' and buf[i+2] == 'T' and buf[i+3] == 'H' and
                buf[i+4] == 'O' and buf[i+5] == 'R' and buf[i+6] == 'I' and
                buf[i+7] == 'Z' and buf[i+8] == 'A' and buf[i+9] == 'T' and
                buf[i+10] == 'I' and buf[i+11] == 'O' and buf[i+12] == 'N' and
                buf[i+13] == ':') {

                var j = i + 14;
                while (j < buf.len and (buf[j] == ' ' or buf[j] == '\t')) j += 1;

                var end = j;
                while (end < buf.len and buf[end] != '\r' and buf[end] != '\n') end += 1;

                if (end > j) {
                    return buf[j..end];
                }
            }
            i += 1;
        }
        return null;
    }

/// Handle /check endpoint with JWT auth and policy evaluation
/// PRD Day 5: Receive HTTP request → validate JWT → evaluate policy → return allow/deny
    fn sendCheckResponse(self: *Self, client_fd: c_int, body: []const u8, raw_request: []const u8) void {
        // Step 1: Extract Authorization header directly from raw buffer - no allocation
        const auth_header = extractAuthHeader(raw_request);

        // Step 2: Authenticate JWT (PRD Day 5 R2)
        const agent = auth.authenticateFromHeader(self.allocator, auth_header) catch |err| {
            // Return 401 for any auth failure (PRD: default deny for invalid JWT)
            const reason = switch (err) {
                error.Unauthorized => "missing authorization header",
                error.InvalidToken => "invalid token format",
                error.ExpiredToken => "token expired",
                error.WrongSecret => "invalid signature",
                error.InvalidClaims => "invalid claims",
                error.OutOfMemory => "server overloaded",
                error.SecretNotConfigured => "server misconfigured",
            };
            self.sendErrorResponse(client_fd, .unauthorized, reason);
            return;
        };

        // Step 3: Parse check request body
        const check_req = self.parseCheckRequest(body);

        // Step 4: Build RequestContext with agent_id from JWT (PRD Day 6)
        const agent_id_str = agent.idSlice();
        const ctx = types.RequestContext.init(
            agent_id_str,
            check_req.path,
            types.Method.parse(check_req.method) catch .GET,
        );

        // Step 5: Evaluate policy (PRD Day 5 R3)
        const policy_set = types.PolicySet{ .policies = self.policies };
        const effect = policy_set.evaluate(&ctx);
        const policy_id = if (effect == .allow) "allow-all" else "deny-default";

        // Step 6: Log decision to audit logger (PRD Day 5 R4)
        self.audit_logger.logCompat(
            agent_id_str,
            check_req.path,
            check_req.method,
            if (effect == .allow) "allow" else "deny",
            policy_id,
        );

        // Step 7: Return response
        var response_body: [256]u8 = undefined;
        var response: []const u8 = undefined;

        if (effect == .allow) {
            prometheus.global_metrics.incAllowed();
            response = std.fmt.bufPrint(&response_body, "{{\"allowed\":true,\"policy_id\":\"{s}\",\"agent_id\":\"{s}\"}}\n", .{
                policy_id,
                agent_id_str,
            }) catch return;
        } else {
            prometheus.global_metrics.incDenied();
            response = std.fmt.bufPrint(&response_body, "{{\"allowed\":false,\"reason\":\"policy denied\",\"policy_id\":\"{s}\"}}\n", .{
                policy_id,
            }) catch return;
        }

        const status_code: u16 = if (effect == .allow) 200 else 403;
        var header_buf: [256]u8 = undefined;
        const header = std.fmt.bufPrint(&header_buf,
            "HTTP/1.1 {d} OK\r\nContent-Type: application/json\r\nContent-Length: {d}\r\n\r\n",
            .{ status_code, response.len },
        ) catch return;

        _ = c.write(client_fd, header.ptr, header.len);
        _ = c.write(client_fd, response.ptr, response.len);
    }

    fn sendNotFoundResponse(self: *Self, client_fd: c_int) void {
        var body_buf: [128]u8 = undefined;
        const body = std.fmt.bufPrint(&body_buf, "{{\"error\":\"not found\",\"mode\":\"{s}\"}}\n", .{
            if (self.mode == .async_epoll) "async-epoll" else "sync-posix"
        }) catch return;

        var header_buf: [128]u8 = undefined;
        const header = std.fmt.bufPrint(&header_buf,
            "HTTP/1.1 404 Not Found\r\nContent-Type: application/json\r\nContent-Length: {d}\r\n\r\n",
            .{body.len},
        ) catch return;

        _ = c.write(client_fd, header.ptr, header.len);
        _ = c.write(client_fd, body.ptr, body.len);
    }

    fn sendErrorResponse(_: *Self, client_fd: c_int, status: HttpStatus, message: []const u8) void {
        var body_buf: [256]u8 = undefined;
        const body = std.fmt.bufPrint(&body_buf, "{{\"error\":\"{s}\"}}\n", .{message}) catch return;

        var header_buf: [256]u8 = undefined;
        const header = std.fmt.bufPrint(&header_buf,
            "HTTP/1.1 {d} {s}\r\nContent-Type: application/json\r\nContent-Length: {d}\r\n\r\n",
            .{ @intFromEnum(status), statusText(status), body.len },
        ) catch return;

        _ = c.write(client_fd, header.ptr, header.len);
        _ = c.write(client_fd, body.ptr, body.len);
    }
};

test "Server init async" {
    const allocator = std.heap.page_allocator;
    var logger = AuditLog.init();

    const policies = &[_]types.Policy{};
    const server = Server.init(allocator, 8080, &logger, policies, "test-secret", .async_epoll);

    try std.testing.expectEqual(@as(u16, 8080), server.port);
    try std.testing.expectEqual(ServerMode.async_epoll, server.mode);
}

test "Server init sync" {
    const allocator = std.heap.page_allocator;
    var logger = AuditLog.init();

    const policies = &[_]types.Policy{};
    const server = Server.init(allocator, 8080, &logger, policies, "test-secret", .sync_posix);

    try std.testing.expectEqual(@as(u16, 8080), server.port);
    try std.testing.expectEqual(ServerMode.sync_posix, server.mode);
}

test "Server statusText" {
    try std.testing.expectEqualStrings("OK", statusText(.ok));
    try std.testing.expectEqualStrings("Bad Request", statusText(.bad_request));
    try std.testing.expectEqualStrings("Unauthorized", statusText(.unauthorized));
    try std.testing.expectEqualStrings("Forbidden", statusText(.forbidden));
}

test "Server parse HTTP request valid" {
    const allocator = std.heap.page_allocator;
    var logger = AuditLog.init();

    var server = Server.init(allocator, 8080, &logger, &[_]types.Policy{}, "secret", .async_epoll);

    const raw = "GET /health HTTP/1.1\r\nHost: localhost\r\n\r\n";
    const parsed = try server.parseHttpRequest(raw);

    try std.testing.expectEqualStrings("GET", parsed.method);
    try std.testing.expectEqualStrings("/health", parsed.path);
}

test "Server parse HTTP request with body" {
    const allocator = std.heap.page_allocator;
    var logger = AuditLog.init();

    var server = Server.init(allocator, 8080, &logger, &[_]types.Policy{}, "secret", .sync_posix);

    const raw = "POST /check HTTP/1.1\r\n\r\n{\"path\":\"/api/test\"}";
    const parsed = try server.parseHttpRequest(raw);

    try std.testing.expectEqualStrings("POST", parsed.method);
    try std.testing.expectEqualStrings("/check", parsed.path);
    try std.testing.expectEqualStrings("{\"path\":\"/api/test\"}", parsed.body);
}