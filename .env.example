# =============================================================================
# AgentGate Environment — copy to .env and fill in your values
#
#   cp .env.example .env && chmod 600 .env
# =============================================================================

# License key for the proxy (obtained from your account or the license server)
# Without a valid key, the proxy will NOT start.
LICENSE_KEY=

# Admin API key for the license server (change in production!)
# Used by scripts/seed-license.sh to create/manage licenses
ADMIN_API_KEY=change-me-in-production

# JWT secret for the AgentGate policy engine (32+ bytes recommended)
# Used to sign internal authentication tokens
AGENTGATE_JWT_SECRET=change-me-in-dev-32bytes-secret-key!
