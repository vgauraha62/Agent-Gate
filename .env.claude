# Claude mode
# Flow: OpenCode CLI → Proxy (:8080) → AgentGate (:8081) → Upstream
# ─────────────────────────────────────────────────────────────
# Upstream options:
#   http://host.docker.internal:11434   — Ollama (local, no key needed)
#   http://litellm:4000                  — LiteLLM (for format translation)
#   https://api.anthropic.com/v1         — Anthropic cloud (needs API key)
# ─────────────────────────────────────────────────────────────
AGENTGATE_PROXY_ANTHROPIC_URL=http://host.docker.internal:11434

AGENTGATE_PROXY_AGENTGATE_URL=http://agentgate:8080
AGENTGATE_PROXY_LISTEN=:8080
AGENTGATE_PROXY_POLICY_TIMEOUT=5s
AGENTGATE_PROXY_UPSTREAM_TIMEOUT=300s
AGENTGATE_PROXY_SKIP_LICENSE=true
